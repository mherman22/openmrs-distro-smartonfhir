{
  "name": "smart-vitals-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A SMART on FHIR app that reviews a patient's vitals: trends, derived BMI, and reference-range flagging",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "esbuild src/app.js src/launch.js --bundle --format=esm --outdir=dist --minify",
    "start": "esbuild src/app.js src/launch.js --bundle --format=esm --outdir=dist --servedir=. --serve=3000"
  },
  "dependencies": {
    "fhirclient": "^2.6.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}

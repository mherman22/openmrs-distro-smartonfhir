# Copy to .env before the first `docker compose up`.

# The HMAC secret both ends of the launch handshake sign with: Keycloak signs the token it sends to
# OpenMRS, and OpenMRS signs the one it sends back. There is no default -- anything able to sign with
# this key can assert any username to Keycloak without a password.
#
#   SMART_LAUNCH_SECRET=$(openssl rand -base64 32)
SMART_LAUNCH_SECRET=

# Where this stack is reachable. The defaults suit a local machine; change them together, because the
# realm's redirect URIs and the audience the FHIR server demands are both derived from them.
#OPENMRS_BASE_URL=http://localhost/openmrs
#FHIR_BASE_URL=http://localhost/openmrs/ws/fhir2/R4
#KEYCLOAK_PUBLIC_URL=http://localhost:8180
#SMART_APP_BASE_URL=http://localhost:3000

# Locally built artefacts. Build each with `mvn clean install` in its own checkout.
#SMARTONFHIR_OMOD=../openmrs-module-smartonfhir/omod/target/smartonfhir-2.0.0-SNAPSHOT.omod
#SMART_AUTH_JAR=../openmrs-contrib-keycloak-smart-auth/keycloak-smart-auth/target/keycloak-smart-auth-1.0.0-SNAPSHOT.jar
#USERSTORE_JAR=../openmrs-contrib-keycloak-auth/openmrs-keycloak-userstore/target/openmrs-keycloak-userstore-1.0.0-SNAPSHOT.jar

# Keycloak requires TLS for anything it does not consider local. Development only.
#SSL_REQUIRED=none

# Copy to .env before the first `docker compose up`.

# The HMAC secret both ends of the launch handshake sign with: Keycloak signs the token it sends to
# OpenMRS, and OpenMRS signs the one it sends back. There is no default -- anything able to sign with
# this key can assert any username to Keycloak without a password.
#
#   SMART_LAUNCH_SECRET=$(openssl rand -base64 32)
SMART_LAUNCH_SECRET=

# Where this stack is reachable. The defaults suit a local machine; change them together, and change
# backend/smart-oauth2.json with them -- the realm's redirect URIs come from here, while the issuer and
# audience the FHIR server demands are stated in that file rather than derived from these.
#OPENMRS_BASE_URL=http://localhost/openmrs
#FHIR_BASE_URL=http://localhost/openmrs/ws/fhir2/R4
#KEYCLOAK_PUBLIC_URL=http://localhost:8180
#SMART_APP_BASE_URL=http://localhost:3000

# The module and the two Keycloak plugins ship in this repository, so nothing here needs building. Set
# these only to run your own build tree instead of the committed copies -- see ARTIFACTS.md. After a
# rebuild, recreate rather than restart: a bind mount follows the inode, so `mvn clean` leaves the
# container reading a file that is gone.
#SMARTONFHIR_OMOD=../openmrs-module-smartonfhir/omod/target/smartonfhir-2.0.0-SNAPSHOT.omod
#SMART_AUTH_JAR=../openmrs-contrib-keycloak-smart-auth/keycloak-smart-auth/target/keycloak-smart-auth-1.0.0-SNAPSHOT.jar
#USERSTORE_JAR=../openmrs-contrib-keycloak-auth/openmrs-keycloak-userstore/target/openmrs-keycloak-userstore-1.0.0-SNAPSHOT.jar

# Which release of the SMART application to run. It is published independently, so this is the one artefact
# here that needs no local build: https://github.com/mherman22/openmrs-smart-vitals-reviews-app
#SMART_APP_VERSION=0.1.3

# Ports, if these are taken.
#OPENMRS_PORT=80
#KEYCLOAK_PORT=8180
#SMART_APP_PORT=3000

# Keycloak requires TLS for anything it does not consider local. Development only.
#SSL_REQUIRED=none
